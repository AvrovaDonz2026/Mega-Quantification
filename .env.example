# Copy to .env next to docker-compose.yml:
#   cp .env.example .env

# Hugging Face token (needed for gated models / higher rate limits)
HF_TOKEN=

# Which recipe to run with `docker compose run --rm megaquant`
# 5090 variants (Compose mixed/w4a4 default to the .5090 files):
#   recipes/qwen3.8-27b-nvfp4-w4a8.5090.yaml
#   recipes/qwen3.8-27b-nvfp4-w4a4.5090.yaml
#   recipes/qwen3.8-27b-nvfp4-mixed.5090.yaml
# Quality mixed (gated Nemotron v3 + local_hessian): recipes/qwen3.8-27b-nvfp4-mixed.yaml
RECIPE=recipes/qwen3.8-27b-nvfp4-w4a8.yaml

# Restrict GPUs on the host before compose, e.g. export CUDA_VISIBLE_DEVICES=0
# Do not put an empty CUDA_VISIBLE_DEVICES= in .env — that hides every GPU from torch.

# Hugging Face cache on the host (weights + datasets stay outside the image)
HF_CACHE=./.cache/huggingface

# Optional local snapshot of Qwen/Qwen3.8-27B (or any HF checkout)
MODELS_DIR=./models

# Quantized checkpoint output
OUTPUTS_DIR=./outputs

# Host path mounted at /opt/megaquant/offload (accelerate CPU offload)
OFFLOAD_DIR=./offload_folder

# Transformers device_map. Use "auto" with CPU offload on a single 32 GB 5090.
MEGAQUANT_DEVICE_MAP=auto
MEGAQUANT_LOW_MEMORY=1
# Leave empty to pack from real VRAM/RAM (VRAM−1GiB, MemTotal−6GiB).
# MEGAQUANT_MAX_MEMORY=
MEGAQUANT_GPU_HEADROOM_GIB=1
MEGAQUANT_CPU_RESERVE_GIB=6
# MEGAQUANT_BATCH_SIZE=4
# MEGAQUANT_NUM_THREADS=
MEGAQUANT_PIN_MEMORY=1

# Extra CLI flags appended by the entrypoint, e.g. --num-samples 256
MEGAQUANT_EXTRA_ARGS=

# GPQA client. Inside Compose, eval talks to the serve-sglang service name.
# MEGAQUANT_SGLANG_BASE_URL=http://serve-sglang:30000/v1
# SGLANG_PORT=30000
# MEGAQUANT_VLLM_BASE_URL=
# GPQA_CSV=/data/dataset/gpqa_diamond.csv
# MEGAQUANT_EVAL_MODEL=outputs/Qwen3.8-27B-NVFP4-W4A8
# SGLANG_IMAGE=megaquant:sglang
# DATA_DIR=./data
# Default EVAL_RECIPE stays recipes/eval-gpqa-diamond.yaml (flashinfer).
# On the stock CUDA 12.8.1 serve image use Triton until a 12.9+ rebuild:
# EVAL_RECIPE=recipes/eval-gpqa-diamond.5090.yaml
#
# Pull a published export (bucket/endpoint stay in gitignored .oss.env):
# OSS_FETCH_SCHEME=w4a8
# OSS_FETCH_HASH=
# OSS_FETCH_DEST=outputs/Qwen3.8-27B-NVFP4-W4A8

# Object storage publish (scripts/oss_publish.py). Keep real values out of git.
# OSS_BUCKET=
# OSS_ENDPOINT=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=

# Override the published/local image tag
MEGAQUANT_IMAGE=megaquant:nvfp4

# Build-time: public CUDA+pip torch (default) vs NGC PyTorch (sm_120 tuned)
# BASE_IMAGE is the PTQ / megaquant:nvfp4 image. SGLANG_BASE_IMAGE is separate.
# BASE_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04
# INSTALL_TORCH=1
# TORCH_INDEX=https://download.pytorch.org/whl/cu128
#
# NGC (needs `docker login nvcr.io`):
# BASE_IMAGE=nvcr.io/nvidia/pytorch:25.08-py3
# INSTALL_TORCH=0
BASE_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04
INSTALL_TORCH=1
TORCH_INDEX=https://download.pytorch.org/whl/cu128
#
# megaquant:sglang toolkit. Default CUDA 12.8.1-devel so existing 5090 images
# stay the default. FlashInfer + DeepGEMM JIT need nvcc 12.9+ for SM 12.0.
# Optional rebuild (confirm tag on NGC; ~28G+ free; not required on a tight disk):
#   SGLANG_BASE_IMAGE=nvidia/cuda:12.9.1-devel-ubuntu24.04 docker compose build serve-sglang
# CUDA 13.0 devel is also a candidate (confirm the exact tag on NGC).
# After a 12.9+ rebuild set SGLANG_ENABLE_JIT_DEEPGEMM=1. On 12.8 keep 0.
# Do not add a Python nvcc probe; this is an operator override.
# SGLANG_BASE_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04
# SGLANG_ENABLE_JIT_DEEPGEMM=0
