# ARM64 / CUDA 13 / GB10. Preserve the upstream torch and kernel wheels.
# Pin the multi-platform index; Docker selects its linux/arm64 manifest.
ARG BASE_IMAGE=lmsysorg/sglang:v0.5.20-cu130@sha256:06e4f2ed21afde4ff513cda65070124e727ba23ccaeff7712b8c40e1097d611f
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG GIT_REVISION=unknown
ARG PIP_NO_INDEX=0
LABEL org.opencontainers.image.source="https://github.com/AvrovaDonz2026/Mega-Quantification" \
    org.opencontainers.image.revision=${GIT_REVISION} \
    org.opencontainers.image.version="0.1.2"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/cache/huggingface \
    MEGAQUANT_ROOT=/opt/megaquant \
    MEGAQUANT_VERIFY_CONTAINER=1 \
    TORCH_CUDA_ARCH_LIST=12.1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /opt/megaquant
COPY pyproject.toml README.md LICENSE ./
COPY docker/requirements-build-spark.txt /tmp/requirements-build-spark.txt
COPY docker/wheelhouse /tmp/wheelhouse
COPY src ./src
COPY recipes ./recipes
COPY docs ./docs
COPY docker ./docker
COPY scripts ./scripts

# Only add the MegaQuant CLI. Do not resolve another torch/sglang wheel set.
RUN python -m pip install --no-cache-dir --no-deps --find-links=/tmp/wheelhouse -r /tmp/requirements-build-spark.txt \
    && python -m pip install --no-cache-dir --no-deps --no-build-isolation . \
    && python scripts/patch_sglang_spark.py \
    && mkdir -p /cache/huggingface /opt/megaquant/outputs /opt/megaquant/offload /models /data \
    && chmod +x /opt/megaquant/docker/entrypoint.sh /opt/megaquant/scripts/*.sh \
    && python scripts/container_manifest.py record --kind sglang \
        --base-image "${BASE_IMAGE}" --revision "${GIT_REVISION}"

ENTRYPOINT ["/opt/megaquant/docker/entrypoint.sh"]
CMD ["serve", "-c", "recipes/eval-gpqa-diamond.spark.yaml"]
